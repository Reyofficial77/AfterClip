# On Netlify, DATABASE_URL is resolved automatically at build/runtime via
# @netlify/database (see src/lib/prisma.ts and scripts/netlify-db-push.mjs).
# You don't need to set anything here for a Netlify deploy.
#
# For local dev WITHOUT `netlify dev` (i.e. plain `next dev`), point this at
# your own Postgres instance:
DATABASE_URL="postgresql://user:password@localhost:5432/afterclip"

# Real Gemini analysis (src/lib/gemini.ts). Get a key from
# https://aistudio.google.com. Without this set, AfterClip falls back to a
# deterministic mock so local dev still works without a key — every mock
# score/note is prefixed with "[MOCK]" so it's never mistaken for a real
# review.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
